# Generate locally: openssl rand -hex 32
API_TOKEN=replace-with-a-random-token
TFL_APP_KEY=
# Base URL supplied for your National Rail LDBWS JSON subscription.
# Must expose /api/20220120/GetDepBoardWithDetails/{crs}; no trailing operation path.
RAIL_BASE_URL=
# Rail Data Marketplace consumer/API key, sent as x-apikey. Keep it server-side.
RAIL_API_KEY=
# Optional legacy direct LDBWS Authorization header. Ignored when RAIL_API_KEY is set.
RAIL_AUTHORIZATION=
